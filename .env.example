# Storage Service environment variables
SERVER_PORT=8087

# Profiles (optional)
SPRING_PROFILES_ACTIVE=

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5440/storagedb
DB_USERNAME=admin
DB_PASSWORD=password

# Storage backend: local | cloudinary
STORAGE_PROVIDER=local

# Local disk storage (objectKey is uploads/yyyy/MM/dd/... under this root)
STORAGE_LOCAL_ROOT=./data/storage
# Base URL for browser access (no trailing slash); URLs are {base}/uploads/...
STORAGE_PUBLIC_BASE_URL=http://localhost:8087

# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keycloak / JWT (OAuth2 resource server)
JWT_ISSUER_URI=http://localhost:8180/realms/ecommerce
JWT_JWK_SET_URI=http://localhost:8180/realms/ecommerce/protocol/openid-connect/certs

# Keycloak client (same pattern as product-service application.yml)
KEYCLOAK_CLIENT_ID=ecommerce-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
